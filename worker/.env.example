# Copy to .env (gitignored). Alchemy reads this at deploy time and binds each key to the Worker
# (Config.redacted keys become secrets). The Mac-side scripts in ../scripts read it too.

# Cloudflare (deploy only; see ~/.claude/skills/cloudflare-deploy/SKILL.md)
CLOUDFLARE_ACCOUNT_ID=128eb0429ed19968217651727f350443
# Either run `bunx alchemy login` (OAuth) or set a scoped token:
# CLOUDFLARE_API_TOKEN=

# Telegram bot (create with @BotFather; chat id comes from /start)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Tokens the Worker checks (generate: openssl rand -hex 24)
ROUTINE_TOKEN=
ADMIN_TOKEN=

# The cloud routine's on-demand trigger (from the routine's settings after creating it)
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=

# Optional fallback scorer
# OPENROUTER_API_KEY=

# Scheduling (Vienna local time)
SUMMARY_LOCAL_TIME=08:30
WEEKLY_LOCAL_TIME=19:00
MAX_FIRES_PER_DAY=10
MIN_FIRE_GAP_MINUTES=60
INBOUND_ALLOW=

# For the Mac-side scripts only
WORKER_URL=https://growth.<account>.workers.dev

# Verified Email Routing destination that receives a copy of direct mail to jobs@
MAIL_ARCHIVE_TO=danyaolekhq@gmail.com

# Scoring thresholds (out of 20). Lower SCORE_LOW_MIN to see more apply-low cards.
SCORE_APPLY_MIN=15
SCORE_LOW_MIN=12

# Djinni sessionid cookie (DevTools → Application → Cookies → djinni.co). Read-only use: fetches the
# logged-in job page so the recruiter's screening questions reach the drafts. Expires; the summary tells you.
DJINNI_SESSION=

# The routine's own cron hours (UTC), so cards can say when the next scheduled run is.
ROUTINE_CRON_HOURS_UTC=5,8,11,14,17
